rid, dark seams between pixel blocks, cell borders, lines between adjacent pixels, blue tint, green tint, color cast, hue shift, or merely overlaying a pixel texture on a high-resolution image.\n**Main priority**: Even when the final output resolution is high, the obvious large-block pixel art style must be maintained, with pixel blocks remaining clearly visible, colors matching the reference's temperature, and no grid lines between blocks.","noise_seed":86928255107193}},{"id":132,"type":"PixelArtDetectorSave","pos":[1484.834564519167,1507.0835270401649],"size":[318.4765625,486],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":219},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"reduce_palette","name":"reduce_palette","type":"BOOLEAN","widget":{"name":"reduce_palette"},"link":null},{"localized_name":"reduce_palette_max_colors","name":"reduce_palette_max_colors","type":"INT","widget":{"name":"reduce_palette_max_colors"},"link":null},{"localized_name":"webp_mode","name":"webp_mode","type":"COMBO","widget":{"name":"webp_mode"},"link":null},{"localized_name":"compression","name":"compression","type":"INT","widget":{"name":"compression"},"link":null},{"localized_name":"save_jpg","name":"save_jpg","type":"BOOLEAN","widget":{"name":"save_jpg"},"link":null},{"localized_name":"save_exif","name":"save_exif","type":"BOOLEAN","widget":{"name":"save_exif"},"link":null},{"localized_name":"resize_w","name":"resize_w","type":"INT","widget":{"name":"resize_w"},"link":null},{"localized_name":"resize_h","name":"resize_h","type":"INT","widget":{"name":"resize_h"},"link":null},{"localized_name":"resize_type","name":"resize_type","type":"COMBO","widget":{"name":"resize_type"},"link":null}],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{"filename_prefix":true,"reduce_palette":true,"reduce_palette_max_colors":true,"we